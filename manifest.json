{
  "manifest_version": 3,
  "name": "Extension Inspector AI",
  "version": "1.0.0",
  "description": "Smartest Browser Extension Inspector - Trust, Performance, Privacy & DNA Engine",
  "permissions": [
    "management",
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Open Extension Inspector AI Dashboard"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
